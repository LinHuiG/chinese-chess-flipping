TCP_PORT=8888
HTTP_PORT=80
HTTP_PUBLISH_PORT=80
# Loopback for a host reverse proxy; set 0.0.0.0 to expose plain HTTP directly.
HTTP_BIND_ADDRESS=127.0.0.1
TCP_WORKER_THREADS=2
# Published server image; no registry credentials belong in this file.
SERVER_IMAGE=ghcr.io/linhuig/chinese-chess-flipping:latest
# Small-server defaults; increase the heap for larger connection counts after measuring.
JAVA_TOOL_OPTIONS=-Xms16m -Xmx128m -XX:+UseSerialGC -XX:MaxDirectMemorySize=16m -Xss512k
